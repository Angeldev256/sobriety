# --- Supabase (Project Settings → API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable (anon) key. Safe in the browser — RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Show "Continue with Google" — only after enabling the Google provider in Supabase (README, step 3)
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Public URL of the app (used for auth redirects and links in emails/notifications)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Notifications job (/api/cron/notifications) ---------------------------
# Secret (service-role) key — SERVER ONLY, bypasses RLS. Needed for the notifications job.
SUPABASE_SECRET_KEY=
# Shared secret the cron caller must send as "Authorization: Bearer <CRON_SECRET>" (Vercel Cron does this automatically)
CRON_SECRET=

# --- Email (optional) ---------------------------------------------------------
# When "true", the app sends welcome, reminder and milestone emails through Resend.
EMAIL_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM="Sobriety Tracker <hello@yourdomain.com>"

# --- Web push notifications (optional) ---------------------------------------
# Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.com

# --- Professional care (optional) --------------------------------------------
# AI intake assistant (https://console.anthropic.com). Without it, the Care page can't start a conversation.
ANTHROPIC_API_KEY=
# Flutterwave (https://dashboard.flutterwave.com → Settings → API keys). Use the TEST secret key
# (FLWSECK_TEST-...) until you're ready to take real payments. Also needs SUPABASE_SECRET_KEY above.
FLW_SECRET_KEY=
# Any long random string; paste the same value as the "Secret hash" in Flutterwave → Settings → Webhooks,
# with the webhook URL https://<your site>/api/flutterwave/webhook
FLW_WEBHOOK_HASH=

# --- Calls (optional TURN relay) ----------------------------------------------
# Video/voice calls connect peer-to-peer using public STUN. Many mobile networks need a TURN
# relay for calls to connect reliably. Comma-separate multiple URLs.
NEXT_PUBLIC_TURN_URLS=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
